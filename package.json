{
  "name": "sandcastle-agent-kimi",
  "version": "0.2.0",
  "description": "Kimi Code agent provider for Sandcastle",
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify-host": "tsx scripts/verify-host.mts",
    "release": "tsx scripts/release.mts",
    "e2e": "tsx e2e/e2e.ts"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yyyyyyyyyunf/sandcastle-agent-kimi.git"
  },
  "peerDependencies": {
    "@fly4ai/sandcastle": ">=0.13.0"
  },
  "devDependencies": {
    "@fly4ai/sandcastle": "0.13.1",
    "@types/node": "^26.2.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true
  }
}
